# Copie para .env na raiz do repositório (o .env não vai para o git).
# Gere cada segredo com: openssl rand -hex 32   (só hex: entram numa URL)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
APP_SECRET=

# http://localhost só para uso nesta máquina; em rede, use HTTPS na frente e https:// aqui
APP_BASE_URL=http://localhost:8080
APP_PORT=8080
APP_TZ=America/Sao_Paulo
# Mostrados em /privacidade e /termos, se você abrir o app para outras pessoas
APP_CONTROLLER_NAME=
APP_CONTACT_EMAIL=

# Contas sem acesso por 12 meses são excluídas (1x/dia). Para desligar num servidor próprio:
# APP_NO_INACTIVE_PURGE=1
