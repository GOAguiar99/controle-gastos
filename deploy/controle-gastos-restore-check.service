[Unit]
Description=Teste mensal de restauração do backup do Controle de Gastos
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/controle-gastos-backup.env
Environment=RESTIC_CACHE_DIR=/var/cache/restic
ExecStart=/usr/local/lib/controle-gastos/restore-check.sh
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
