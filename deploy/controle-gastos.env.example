# /etc/controle-gastos.env  (chmod 600, dono root)

# Login com Google (Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth,
# tipo "Aplicativo da Web"). URI de redirecionamento autorizado: <APP_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública https do app, sem barra no fim
APP_BASE_URL=https://seu-subdominio.duckdns.org
# Quem pode entrar: e-mails separados por vírgula ("*" libera qualquer conta Google verificada)
APP_ALLOWED_EMAILS=

# 32+ caracteres aleatórios (assina o cookie temporário do login): openssl rand -hex 32
APP_SECRET=
# PostgreSQL pelo socket local, autenticação peer (sem senha)
DATABASE_URL=postgres:///controle-gastos?host=/var/run/postgresql&user=controle-gastos
ADDR=127.0.0.1:8080
APP_TZ=America/Sao_Paulo
