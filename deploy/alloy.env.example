# /etc/alloy/grafana-cloud.env  (chmod 640, root:alloy) — credenciais do Grafana Cloud para o Alloy.
# Grafana Cloud → seu stack → Connections → "Hosted Prometheus metrics" e "Hosted logs" (Details):
# Prometheus: URL de remote write, termina em /api/prom/push; usuário = número da instância
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
# Loki: URL termina em /loki/api/v1/push; usuário = número da instância de logs
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
# Access Policy token com os escopos metrics:write e logs:write (só esses)
GRAFANA_CLOUD_TOKEN=
