# /etc/controle-gastos-backup.env  (chmod 600, dono root) — lido pelo backup diário e pelo teste de restauração.

# Repositório restic no OCI Object Storage, acessado pelo rclone com a identidade da própria VM
# (Dynamic Group + Policy no console da Oracle): nenhuma chave de nuvem fica neste arquivo.
# Formato: rclone:oci:<bucket>/<pasta>
RESTIC_REPOSITORY=rclone:oci:controle-gastos-backups/restic
# Senha que criptografa o repositório. GUARDE UMA CÓPIA FORA DA VM (gerenciador de senhas):
# sem ela, os backups não podem ser lidos. O setup-vm.sh gera o arquivo se ele não existir.
RESTIC_PASSWORD_FILE=/etc/controle-gastos-restic.pass

# rclone (backend Oracle Object Storage, autenticação pela instância)
RCLONE_CONFIG_OCI_TYPE=oracleobjectstorage
RCLONE_CONFIG_OCI_PROVIDER=instance_principal_auth
# Object Storage → Bucket → "Namespace" (também em Tenancy details)
RCLONE_CONFIG_OCI_NAMESPACE=
RCLONE_CONFIG_OCI_REGION=sa-saopaulo-1

# Healthchecks.io: URLs de ping dos dois checks (https://hc-ping.com/<uuid>), sem barra no fim
HC_BACKUP_URL=
HC_RESTORE_URL=
